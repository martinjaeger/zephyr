# LoRaWAN Firmware-Upgrade Over The Air (FUOTA) configuration options
#
# Copyright (c) 2022 Martin Jäger <martin@libre.solar>
# SPDX-License-Identifier: Apache-2.0

config LORAWAN_FUOTA
	bool "LoRaWAN FUOTA backend"
	depends on LORAWAN
	help
	  ToDo

if LORAWAN_FUOTA

module = LORAWAN_FUOTA
module-str = lorawan_fuota
source "subsys/logging/Kconfig.template.log_config"

config LORAWAN_FUOTA_THREAD_PRIORITY
	int "Thread priority"
	default 2
	help
	  Priority of the thread running the FUOTA service.

config LORAWAN_FUOTA_THREAD_STACK_SIZE
	int "FUOTA thread stack size"
	default 2048
	help
	  Stack size of thread running the FUOTA service in the background.

config LORAWAN_APP_CLOCK_SYNC_VERSION
	int "Application Layer Clock Synchronization Specification"
	range 1 2
	default 1
	help
	  The implementation considers different versions of the specification
	  released by the LoRa Alliance.

	  Select one of the following revisions:

	  1: TS003-1.0.0
	  2: TS003-2.0.0 (not fully supported, only for testing)

config LORAWAN_FRAG_TRANSPORT_VERSION
	int "Fragmented Data Block Transport Specification"
	range 1 2
	default 1
	help
	  The implementation considers different versions of the specification
	  released by the LoRa Alliance.

	  Select one of the following revisions:

	  1: TS004-1.0.0
	  2: TS004-2.0.0 (not fully supported, only for testing)

config LORAWAN_REMOTE_MULTICAST_VERSION
	int "Remote Multicast Setup Specification"
	range 1 1
	default 1
	help
	  The implementation considers different versions of the specification
	  released by the LoRa Alliance.

	  Select one of the following revisions:

	  1: TS005-1.0.0

	  (TS005-2.0.0 not yet implemented)

endif # LORAWAN_FUOTA
